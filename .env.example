# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (fixed to 3000 in AI Studio environment)
PORT=3000

# Authentication & Security
JWT_SECRET="naz_export_production_jwt_secret_key_change_in_production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Database Connection (optional: defaults to local persistent data/db.json)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/naz_export?retryWrites=true&w=majority"
POSTGRES_URL="postgresql://user:password@localhost:5432/naz_export"

# Optional Cloudinary Storage Configuration for remote image CDN
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""
